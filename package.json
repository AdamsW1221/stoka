{
  "name": "stoka-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Stoka - Sistema Multi-Tenant de Inventario (PWA iOS/Android + Fastify API)",
  "scripts": {
    "build": "cd frontend && npm install --legacy-peer-deps && npx expo export -p web",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:pwa": "npm --prefix frontend run pwa",
    "seed": "npm --prefix apps/api run seed"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "google-auth-library": "^9.14.2",
    "nodemailer": "^6.9.15",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.8.0",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
